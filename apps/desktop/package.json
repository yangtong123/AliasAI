{
  "name": "@aliasai/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/main/index.cjs",
  "scripts": {
    "dev": "pnpm run build:preload && concurrently -k \"node scripts/build-main.mjs --watch\" \"vite --config renderer/vite.config.ts\" \"wait-on http://127.0.0.1:5173 dist/main/index.cjs && electron .\"",
    "start": "electron .",
    "build": "pnpm run build:main && pnpm run build:preload && pnpm run build:renderer",
    "build:main": "node scripts/build-main.mjs",
    "build:preload": "tsc --project preload/tsconfig.build.json && node scripts/finalize-preload.mjs",
    "build:renderer": "vite build --config renderer/vite.config.ts"
  },
  "dependencies": {
    "@aliasai/application": "workspace:*",
    "@aliasai/crypto": "workspace:*",
    "@aliasai/database": "workspace:*",
    "@aliasai/document": "workspace:*",
    "@aliasai/domain": "workspace:*",
    "@aliasai/entity-resolution": "workspace:*",
    "@aliasai/privacy-detection": "workspace:*",
    "@aliasai/python-bridge": "workspace:*",
    "@vitejs/plugin-react": "^5.0.2",
    "better-sqlite3": "13.0.3",
    "electron": "^43.4.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "vite": "^7.1.3"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.4",
    "wait-on": "^8.0.3"
  }
}
